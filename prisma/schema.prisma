generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Provider {
  META
  LOCAL
}

/// Single row (id = 1) holding portal-wide settings.
model Setting {
  id             Int       @id @default(1)
  provider       Provider  @default(META)
  wahaUrl        String?
  wahaApiKey     String?
  wahaSession    String    @default("default")
  /// When the scheduler last ran, so the dashboard can warn if it stopped.
  lastDispatchAt DateTime?
  /// Last time the scheduler sent CRON_SECRET in the web address (?key=) instead of the Authorization header.
  cronKeyInUrlAt  DateTime?
  /// The portal-wide default look (lib/appearance.ts): icon set, tiles, cards, UI style, chart library.
  appearance     Json?
  /// Wallet recharges: the UPI ID and name shown on the recharge QR (lib/wallet.ts).
  walletUpiId    String?
  walletPayee    String?
  /// GST on wallet receipts: off until Thabaal is registered; gstin is printed when on.
  gstEnabled     Boolean   @default(false)
  gstin          String?
  updatedAt      DateTime  @updatedAt
}

/// A business whose customers and campaigns the portal runs. It sends from its own
/// WhatsApp numbers when it has any, otherwise from the env-configured number.
model Client {
  id                  String            @id @default(cuid())
  name                String            @unique
  /// Meta access token shared by the client's numbers unless a number has its own.
  waToken             String?
  /// Superseded by WhatsAppNumber; kept so older rows stay readable.
  waPhoneNumberId     String?           @unique
  waBusinessAccountId String?
  /// Branding their login sees. Colours are #rrggbb; image paths are under /public or full URLs.
  brandPrimary        String?
  brandAccent         String?
  logoUrl             String?
  bannerUrl           String?
  /// Image used by image-header templates that have none of their own, including the picture order updates.
  defaultImageUrl     String?
  /// City the business delivers from; customer regions are "<city> city" / "Outside <city>". Null means Madurai (clients set up before this).
  homeCity            String?
  /// Order steps the client picked in Settings (lib/order-flow.ts): pickup, deliver, courier or service. Null = deliver.
  orderFlow           String?
  /// Kind of business (lib/business-types.ts): retail, restaurant, service, wholesale or other. Null = not chosen yet.
  businessType        String?
  /// Extra fields this client keeps on customers and orders: [{ key, label, type, options?, on }] (lib/custom-fields.ts).
  customFields        Json?
  /// Who pays Meta for this client's messages: "direct" (their own Meta billing, the default) or "wallet" (Thabaal wallet).
  billingMode         String            @default("direct")
  /// Wallet rates per delivered message before GST, by category; missing ones use Meta's rate (lib/wallet.ts).
  walletRates         Json?
  /// Warn the client when their wallet falls below this many rupees.
  walletLowAlert      Float             @default(200)
  walletEntries       WalletEntry[]
  tagline             String?
  website             String?
  supportPhone        String?
  /// Hours a customer must wait between marketing messages; 0 turns the rule off.
  marketingGapHours   Int               @default(72)
  /// No marketing sends between these HH:mm times (IST); null turns quiet hours off.
  quietFrom           String?           @default("21:00")
  quietTo             String?           @default("09:00")
  /// Refill reminder: this many days after an order, send refillTemplate. Null turns it off.
  refillDays          Int?
  refillTemplateId    String?
  /// Google Sheet tabs shared as "anyone with the link"; synced into Customers and Orders.
  sheetCustomersUrl   String?
  sheetOrdersUrl      String?
  sheetSyncedAt       DateTime?
  /// Result of the last sync, shown on the sheet page (e.g. "12 added, 3 updated").
  sheetSyncNote       String?
  /// This client's own live-log Apps Script web app (/exec link) and the shared secret it checks.
  /// Unset: no live updates, except the first client, which keeps the deployment-wide GOOGLE_SHEET_WEBHOOK_URL.
  /// Prefix of this client's order numbers (FM in FM-1001), unique across clients; set from the name if blank.
  orderPrefix         String?           @unique
  /// Last order number used for this client; the next order takes orderSeq + 1.
  orderSeq            Int               @default(1000)
  sheetHookUrl        String?
  sheetHookSecret     String?
  /// Win-back: customers whose last order is this many days old are tagged "lapsed" and sent winbackTemplate once.
  lapsedDays          Int               @default(60)
  winbackTemplateId   String?
  /// WhatsApp Manager → Payment configurations: the name of the active one (e.g. a UPI VPA). Null turns payment requests off.
  paymentConfig       String?
  /// Use a customer's loyalty points automatically on each new order (cart or hand-entered), before payment is asked.
  loyaltyAutoRedeem   Boolean           @default(false)
  /// Portal sections disabled for this client by the portal owner (e.g. ["orders", "catalogue", "calls"]). Empty means all sections enabled.
  disabledSections    String[]          @default([])
  /// Icon set for this client's portal: "hugeicons" (default) or "lucide".
  iconPack            String            @default("hugeicons")
  /// Look of the coloured icon tiles: "3d" (glossy, default) or "2d" (flat).
  iconLook            String            @default("3d")
  /// This client's own look, overriding the portal default key by key (lib/appearance.ts).
  appearance          Json?
  audiences           Audience[]
  topUps              TopUp[]
  createdAt           DateTime          @default(now())
  users               User[]
  customers           Customer[]
  pending             PendingCustomer[]
  templates           Template[]
  campaigns           Campaign[]
  numbers             WhatsAppNumber[]
  orders              Order[]
}

/// One sending number on Meta's Cloud API. Templates belong to its WhatsApp Business
/// Account, so numbers in the same account share templates.
model WhatsAppNumber {
  id                String     @id @default(cuid())
  clientId          String
  client            Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label             String
  phoneNumberId     String     @unique
  businessAccountId String
  displayPhone      String?
  verifiedName      String?
  /// Overrides the client's token, for numbers in an account the shared token can't reach.
  token             String?
  isDefault         Boolean    @default(false)
  /// From Meta: GREEN, YELLOW, RED or UNKNOWN.
  qualityRating     String?
  /// From Meta: TIER_250, TIER_1K, TIER_10K, TIER_100K or TIER_UNLIMITED.
  messagingTier     String?
  /// Our own lower limit while warming a new number up; null follows Meta's tier.
  dailyCap          Int?
  statusCheckedAt   DateTime?
  createdAt         DateTime   @default(now())
  campaigns         Campaign[]
  messages          Message[]
  replies           Reply[]
  calls             Call[]

  @@index([clientId])
}

enum Role {
  ADMIN // sees and manages every client
  CLIENT // a login for one client; what it may do is set by access
}

/// What a client login may do within its own business.
enum ClientAccess {
  MANAGER // everything for their business: campaigns, templates, customers, automations, orders, replies
  STAFF // day-to-day: orders and dispatch, replies, Google Sheet, QR codes
  VIEWER // look only
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  /// Raised when the password changes, so logins made before it stop working on every device.
  sessionVersion Int        @default(0)
  role         Role         @default(CLIENT)
  access       ClientAccess @default(STAFF)
  clientId     String?
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
}

model Customer {
  id               String    @id @default(cuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name             String
  phone            String // E.164 digits only, e.g. 919876543210
  tags             String[]  @default([])
  purchases        String? // items as written on the paper order sheets
  /// Area, cleaned up (e.g. "Sellur"); region groups areas: Madurai city / Outside Madurai / Not sure.
  location         String?
  region           String?
  /// The location exactly as written on the order sheet.
  locationRaw      String?
  optedOut         Boolean   @default(false)
  /// How and when the customer agreed to receive WhatsApp messages (Meta requires opt-in).
  optInSource      String?
  optInAt          DateTime?
  /// Set when Meta says the number can't receive messages; campaigns skip them.
  unreachable      Boolean   @default(false)
  /// When the win-back message went out; cleared when they order again so a later lapse can be won back too.
  winbackSentAt    DateTime?
  /// WhatsApp calling: when we last asked to call them, and until when they allowed it (null = not allowed).
  callAskedAt      DateTime?
  callAllowedUntil DateTime?
  /// Values of the client's custom fields, by key (lib/custom-fields.ts).
  extra            Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  messages         Message[]
  replies          Reply[]
  orders           Order[]
  calls            Call[]
  loyaltyEntries   LoyaltyEntry[]

  @@unique([clientId, phone])
  @@index([phone])
  @@index([clientId, region])
  @@index([clientId, optedOut, unreachable])
}

/// Customers transcribed from paper sheets whose phone number was blank or unusable.
/// Kept apart from Customer so campaigns never try to message them.
model PendingCustomer {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String?
  rawPhone  String? // exactly as transcribed (partial / two numbers / typo)
  location  String?
  payment   String?
  items     String?
  notes     String?
  page      String?
  source    String // spreadsheet the row came from
  createdAt DateTime @default(now())
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

enum HeaderType {
  NONE
  TEXT
  IMAGE
}

model Template {
  id             String           @id @default(cuid())
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name           String // Meta name: lowercase, numbers, underscores
  language       String           @default("en")
  category       TemplateCategory
  headerType     HeaderType       @default(NONE)
  headerText     String?
  headerMediaUrl String?
  body           String
  footer         String?
  /// [{ type: "QUICK_REPLY" | "URL" | "PHONE_NUMBER" | "COPY_CODE", text, url?, phone? }]
  buttons        Json             @default("[]")
  /// { "1": { source: "name" | "phone" | "static", value?: string } } for body; "h1" for header
  variables      Json             @default("{}")
  /// Authentication templates only
  codeExpiryMins Int?
  securityNote   Boolean          @default(true)

  metaId       String?        @unique
  status       TemplateStatus @default(DRAFT)
  statusReason String?
  /// Meta's quality score for the template: GREEN | YELLOW | RED | UNKNOWN.
  qualityScore String?
  lastSyncedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  campaigns Campaign[]
  messages  Message[]

  /// The WhatsApp Business Account the template lives in; null for the env-configured number.
  businessAccountId String?

  @@unique([clientId, businessAccountId, name, language])
}

enum ScheduleType {
  ONCE
  WEEKLY
}

model Campaign {
  id              String          @id @default(cuid())
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String
  templateId      String
  template        Template        @relation(fields: [templateId], references: [id])
  /// Number to send from; null uses the client's default number.
  senderId        String?
  sender          WhatsAppNumber? @relation(fields: [senderId], references: [id], onDelete: SetNull)
  audienceTag     String? // null = all opted-in customers
  scheduleType    ScheduleType    @default(WEEKLY)
  daysOfWeek      Int[]           @default([]) // 0 = Sunday … 6 = Saturday
  sendTime        String          @default("10:00") // HH:mm in timezone
  runAt           DateTime? // for ONCE
  timezone        String          @default("Asia/Kolkata")
  batchSize       Int             @default(100)
  intervalMinutes Int             @default(10)
  active          Boolean         @default(true)
  nextRunAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  runs            CampaignRun[]
}

enum RunStatus {
  RUNNING
  WAITING_TEMPLATE
  WAITING_CONNECTION
  WAITING_LIMIT // the number used up its 24-hour messaging limit
  WAITING_QUALITY // Meta rated the number red; paused to protect it
  WAITING_QUIET // inside the client's quiet hours
  WAITING_FUNDS // the client's Thabaal wallet is too low; resumes after a recharge
  COMPLETED
  CANCELLED
}

model CampaignRun {
  id           String    @id @default(cuid())
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scheduledFor DateTime
  status       RunStatus @default(RUNNING)
  total        Int       @default(0)
  nextBatchAt  DateTime  @default(now())
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  messages     Message[]

  @@unique([campaignId, scheduledFor])
  @@index([status, nextBatchAt])
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

model Message {
  id              String          @id @default(cuid())
  runId           String?
  run             CampaignRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  templateId      String?
  template        Template?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateName    String
  body            String? // rendered text at send time
  status          MessageStatus   @default(QUEUED)
  waMessageId     String?         @unique
  error           String?
  /// Meta error code when a send failed, e.g. 131026.
  errorCode       Int?
  simulated       Boolean         @default(false)
  senderId        String?
  sender          WhatsAppNumber? @relation(fields: [senderId], references: [id], onDelete: SetNull)
  provider        Provider        @default(META)
  createdAt       DateTime        @default(now())
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  failedAt        DateTime?
  /// From Meta's status webhook: marketing | utility | authentication | service, and whether it was charged.
  pricingCategory String?
  billable        Boolean?

  @@index([runId, status])
  @@index([createdAt])
  @@index([status])
  @@index([customerId, createdAt])
  @@index([senderId])
}

/// A message a customer sent back: a typed reply or a quick-reply button tap such as "Order now".
model Reply {
  id          String          @id @default(cuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  text        String
  kind        String // text | button | media | order
  /// Media the customer sent (image, audio, video, document, sticker); fetched from Meta when viewed.
  mediaId     String?
  mediaType   String?
  waMessageId String?         @unique
  /// The number the customer wrote to.
  senderId    String?
  sender      WhatsAppNumber? @relation(fields: [senderId], references: [id], onDelete: SetNull)
  handled     Boolean         @default(false)
  receivedAt  DateTime        @default(now())

  @@index([customerId, receivedAt])
  @@index([handled, receivedAt])
  @@index([senderId])
}

enum OrderStatus {
  NEW
  CONFIRMED
  PAID
  DISPATCHED
  DELIVERED
  CANCELLED
}

/// A cart a customer sent from the WhatsApp catalogue.
model Order {
  id                 String      @id @default(cuid())
  /// Running number shown to people as RG-1001, RG-1002…; also the WhatsApp payment reference.
  number             Int         @unique @default(autoincrement())
  /// What people see and quote: the client's own prefix and running number (FM-1001). Null on orders made
  /// before per-client numbers, which show as RG-<1000 + number> (lib/order-ref.ts).
  ref                String?     @unique
  clientId           String
  client             Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  waMessageId        String?     @unique
  catalogId          String?
  /// The note the customer typed with the cart, if any.
  note               String?
  /// [{ id: retailer id, name?: product name, quantity, price, currency }]
  items              Json
  total              Float       @default(0)
  currency           String      @default("INR")
  status             OrderStatus @default(NEW)
  /// When the order was marked packed (the "Packed" step); status stays CONFIRMED or PAID until it is dispatched.
  packedAt           DateTime?
  /// When the order reached each step; stamped by a database trigger on status changes
  /// (prisma/sql/2026-10-18-order-step-times.sql). Null on orders from before it.
  confirmedAt        DateTime?
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  /// Our own notes: payment mode, delivery slot, address.
  internalNote       String?
  /// Values of the client's custom order fields, by key (lib/custom-fields.ts).
  extra              Json?
  /// When the refill reminder for this order went out, so it's sent once.
  reminderSentAt     DateTime?
  /// Where the order came from outside WhatsApp, e.g. a Google Sheet row; keeps a sync from adding it twice.
  externalRef        String?     @unique
  /// "Review and pay" message sent on WhatsApp; Meta's payment webhook fills paidAt and the UPI transaction id.
  paymentRequestedAt DateTime?
  /// One automatic reminder when the payment request is still unpaid after a few hours.
  paymentReminderAt  DateTime?
  paidAt             DateTime?
  paymentTxnId       String?
  /// How the customer pays: upi_whatsapp ("Review and pay"), upi (another UPI app or the shop's QR), cod, cash,
  /// bank, card or other. Null until someone decides (a WhatsApp cart defaults to UPI when payments are on).
  paymentMethod      String?
  /// How the payment was confirmed: meta (WhatsApp payment update), utr (customer sent a UPI reference),
  /// screenshot, staff (recorded by hand) or verified (a customer's claim checked by staff).
  paymentSource      String?
  /// Amount actually received; less than the total means part paid.
  paidAmount         Float?
  /// The customer says they paid, but nothing has confirmed it yet: staff check and verify.
  paymentClaimedAt   DateTime?
  paymentClaimNote   String?
  /// The last WhatsApp payment attempt that failed, and Meta's reason.
  paymentFailedAt    DateTime?
  paymentFailReason  String?
  /// Cash on delivery / cash: who collected it.
  collectedBy        String?
  /// Money given back after a cancellation or a problem with the order.
  refundedAt         DateTime?
  refundAmount       Float?
  refundNote         String?
  /// Loyalty points used on this order; total is already reduced by their value (100 points = ₹50).
  /// Points used on a cancelled order go back to the customer (lib/loyalty-redeem.ts).
  pointsRedeemed     Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([clientId, status, createdAt])
  @@index([customerId])
}

/// A saved customer filter (tags, area, what they bought, when they last ordered) that campaigns can send to.
/// Campaigns refer to it as audienceTag = "aud:<id>".
model Audience {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  /// AudienceFilter, see src/lib/audiences.ts
  filter    Json
  createdAt DateTime @default(now())

  @@unique([clientId, name])
}

enum CallDirection {
  INCOMING
  OUTGOING
}

enum CallStatus {
  RINGING // incoming: ringing in the portal; outgoing: ringing on the customer's phone
  ANSWERED // someone in the portal picked up; audio flows between their browser and Meta
  ENDED
  MISSED // incoming: hung up before anyone answered; outgoing: the customer didn't pick up
  REJECTED
}

/// A WhatsApp voice call a customer made to one of our numbers, answered in the browser.
model Call {
  id         String          @id @default(cuid())
  waCallId   String          @unique
  direction  CallDirection   @default(INCOMING)
  /// The number that was called; null for the env-configured number.
  senderId   String?
  sender     WhatsAppNumber? @relation(fields: [senderId], references: [id], onDelete: SetNull)
  clientId   String?
  customerId String?
  customer   Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  fromPhone  String
  callerName String?
  status     CallStatus      @default(RINGING)
  /// Meta's SDP offer from the connect webhook; the answering browser replies to it.
  offerSdp   String?
  /// Outgoing calls: the customer's SDP answer, applied by the browser that dialled.
  answerSdp  String?
  answeredBy String?
  startedAt  DateTime        @default(now())
  answeredAt DateTime?
  endedAt    DateTime?
  /// Seconds, from Meta's terminate webhook.
  duration   Int?

  @@index([status, startedAt])
  @@index([clientId, startedAt])
}

/// Money added to the WhatsApp (Meta) account, entered by hand: Meta has no API for the balance.
/// The dashboard subtracts estimated message spend since the first top-up.
model TopUp {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount    Float
  note      String?
  addedBy   String?
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

/// The Thabaal wallet ledger (lib/wallet.ts). Balance = sum of DONE amounts. Credits are positive,
/// message charges negative. One MESSAGE entry per charged message (messageId is unique).
model WalletEntry {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// RECHARGE | MESSAGE | ADJUSTMENT | REFUND
  kind      String
  /// Rupees, GST included: + adds to the balance, - takes from it.
  amount    Float
  /// PENDING (recharge waiting for approval) | DONE | REJECTED
  status    String   @default("DONE")
  messageId String?  @unique
  /// For MESSAGE entries: marketing | utility | authentication | service.
  category  String?
  /// UPI transaction reference the client entered for a recharge.
  utr       String?
  note      String?
  createdBy String?
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime @default(now())

  @@index([clientId, status, createdAt])
  @@index([utr])
}

/// Failed password logins, for slowing down guessing (lib/login-guard.ts). Old rows are pruned.
/// Loyalty points given, taken back or used on a bill by hand (Customers › Loyalty), with the reason and who did it.
/// Points earned and used on orders come from the orders themselves; these are the hand changes for the history.
model LoyaltyEntry {
  id         String   @id @default(cuid())
  clientId   String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Points added (positive) or taken off (negative).
  delta      Int
  /// "give", "take" or "redeem"
  kind       String
  reason     String
  byName     String?
  /// Whether the customer was told on WhatsApp.
  told       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([customerId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  /// "email:<address>" or "ip:<address>"
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
