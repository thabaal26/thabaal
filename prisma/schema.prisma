generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Provider {
  META
  LOCAL
}

/// Single row (id = 1) holding portal-wide settings.
model Setting {
  id          Int      @id @default(1)
  provider    Provider @default(META)
  wahaUrl     String?
  wahaApiKey  String?
  wahaSession String   @default("default")
  updatedAt   DateTime @updatedAt
}

/// A business whose customers and campaigns the portal runs. Its WhatsApp Cloud API
/// credentials are optional; without them it sends through the env-configured number.
model Client {
  id                  String            @id @default(cuid())
  name                String            @unique
  waToken             String?
  waPhoneNumberId     String?           @unique
  waBusinessAccountId String?
  createdAt           DateTime          @default(now())
  users               User[]
  customers           Customer[]
  pending             PendingCustomer[]
  templates           Template[]
  campaigns           Campaign[]
}

enum Role {
  ADMIN // sees and manages every client
  CLIENT // read-only view of its own client
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CLIENT)
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model Customer {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  phone     String // E.164 digits only, e.g. 919876543210
  tags      String[]  @default([])
  purchases String? // items as written on the paper order sheets
  optedOut  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@unique([clientId, phone])
  @@index([phone])
}

/// Customers transcribed from paper sheets whose phone number was blank or unusable.
/// Kept apart from Customer so campaigns never try to message them.
model PendingCustomer {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String?
  rawPhone  String? // exactly as transcribed (partial / two numbers / typo)
  location  String?
  payment   String?
  items     String?
  notes     String?
  page      String?
  source    String // spreadsheet the row came from
  createdAt DateTime @default(now())
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

enum HeaderType {
  NONE
  TEXT
  IMAGE
}

model Template {
  id             String           @id @default(cuid())
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name           String // Meta name: lowercase, numbers, underscores
  language       String           @default("en")
  category       TemplateCategory
  headerType     HeaderType       @default(NONE)
  headerText     String?
  headerMediaUrl String?
  body           String
  footer         String?
  /// [{ type: "QUICK_REPLY" | "URL" | "PHONE_NUMBER" | "COPY_CODE", text, url?, phone? }]
  buttons        Json             @default("[]")
  /// { "1": { source: "name" | "phone" | "static", value?: string } } for body; "h1" for header
  variables      Json             @default("{}")
  /// Authentication templates only
  codeExpiryMins Int?
  securityNote   Boolean          @default(true)

  metaId         String?          @unique
  status         TemplateStatus   @default(DRAFT)
  statusReason   String?
  lastSyncedAt   DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  campaigns      Campaign[]
  messages       Message[]

  @@unique([clientId, name, language])
}

enum ScheduleType {
  ONCE
  WEEKLY
}

model Campaign {
  id              String        @id @default(cuid())
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String
  templateId      String
  template        Template      @relation(fields: [templateId], references: [id])
  audienceTag     String? // null = all opted-in customers
  scheduleType    ScheduleType  @default(WEEKLY)
  daysOfWeek      Int[]         @default([]) // 0 = Sunday … 6 = Saturday
  sendTime        String        @default("10:00") // HH:mm in timezone
  runAt           DateTime? // for ONCE
  timezone        String        @default("Asia/Kolkata")
  batchSize       Int           @default(100)
  intervalMinutes Int           @default(10)
  active          Boolean       @default(true)
  nextRunAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  runs            CampaignRun[]
}

enum RunStatus {
  RUNNING
  WAITING_TEMPLATE
  WAITING_CONNECTION
  COMPLETED
  CANCELLED
}

model CampaignRun {
  id           String     @id @default(cuid())
  campaignId   String
  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scheduledFor DateTime
  status       RunStatus  @default(RUNNING)
  total        Int        @default(0)
  nextBatchAt  DateTime   @default(now())
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
  messages     Message[]

  @@unique([campaignId, scheduledFor])
  @@index([status, nextBatchAt])
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

model Message {
  id           String        @id @default(cuid())
  runId        String?
  run          CampaignRun?  @relation(fields: [runId], references: [id], onDelete: SetNull)
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  templateId   String?
  template     Template?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateName String
  body         String? // rendered text at send time
  status       MessageStatus @default(QUEUED)
  waMessageId  String?       @unique
  error        String?
  simulated    Boolean       @default(false)
  provider     Provider      @default(META)
  createdAt    DateTime      @default(now())
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  failedAt     DateTime?

  @@index([runId, status])
  @@index([createdAt])
  @@index([status])
}
