# ── Database (Vercel → Storage → Neon Postgres fills these in automatically) ──
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# ── Login ──
# Random string, 32+ characters. Generate one with: openssl rand -base64 32
AUTH_SECRET=""
# Used by `npm run seed` to create or reset the login account
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Store Owner"

# ── Google OAuth 2.0 (Continue with Google) ──
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# Authorized redirect URI: https://yourdomain.com/api/auth/google/callback (and http://localhost:3000/api/auth/google/callback for dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Scheduler ── any random string; the cron URL must send it
CRON_SECRET=""

# ── Business ──
BUSINESS_NAME="Your Business"
APP_TIMEZONE="Asia/Kolkata"
DEFAULT_COUNTRY_CODE="91"

# ── WhatsApp Cloud API (leave empty for demo mode) ──
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v23.0"

# Email to Thabaal (custom work requests) via Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Optional: sender once your domain is verified in Resend, e.g. thabaal <requests@thabaal.in>
RESEND_FROM=
# Optional: inbox for requests (default thabaal26@gmail.com)
THABAAL_INBOX=
